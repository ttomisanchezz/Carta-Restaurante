# Carta interactiva con video — variables de entorno
#
# Este archivo SE COMMITEA. Nunca tiene valores reales de produccion.
# El archivo que usás localmente es .env.local y NO se commitea (ver .gitignore).
#
# NO HAY STACK LOCAL NI DOCKER. Este proyecto trabaja contra un proyecto de
# Supabase en la nube. Ningun comando genera este archivo por vos: se completa
# UNA vez a mano, copiando los valores del panel de Supabase.
#
#   cp .env.example .env.local     y despues completar los seis valores de abajo.
#
# Todo sale de https://supabase.com/dashboard con el proyecto abierto.

# ---------------------------------------------------------------------------
# Supabase — TODAS se completan de una. Paso que las exige: 1 para URL, ANON_KEY,
# SERVICE_ROLE_KEY y TEST_DB_PROJECT_REF; 3 para PROJECT_REF, ACCESS_TOKEN y DB_PASSWORD.
# (§10 Bootstrap paso 8 falla con instrucciones si falta cualquiera)
# ---------------------------------------------------------------------------

# Identifica el proyecto para `supabase link`. Es el subdominio de la URL:
# en https://abcdefghijklm.supabase.co  el ref es  abcdefghijklm
SUPABASE_PROJECT_REF=

# Autentica la CLI sin login interactivo, que colgaria el bootstrap.
# Account (arriba a la derecha) > Access Tokens > Generate new token.
# SECRETO: da acceso a toda tu cuenta, no solo a este proyecto.
SUPABASE_ACCESS_TOKEN=

# La contraseña que pusiste al crear el proyecto. La usan `link` y `db push`.
# Si no la tenes: Project Settings > Database > Reset database password.
SUPABASE_DB_PASSWORD=

# URL de la API de PostgREST/Auth. Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co

# Clave publica. Llega al navegador: tratala como publicada, nunca como secreto.
# Su unica proteccion son las policies de RLS. Project Settings > API > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SALTEA RLS POR COMPLETO.
# Solo servidor y scripts. Jamas en un componente "use client", jamas con prefijo
# NEXT_PUBLIC_, jamas en un log ni pegada en un chat.
# Project Settings > API > service_role (hay que revelarla).
SUPABASE_SERVICE_ROLE_KEY=

# Confirmacion explicita de contra que proyecto pueden correr los tests.
# TIENE que ser identico al ref de NEXT_PUBLIC_SUPABASE_URL o la suite no arranca.
# Existe porque los tests crean y BORRAN filas: si algun dia pegas aca las
# credenciales de un proyecto con datos de un cliente real, esto lo frena.
TEST_DB_PROJECT_REF=

# ---------------------------------------------------------------------------
# Video — requeridas desde el paso 11 (proveedor) y el paso 16 (subida firmada)
# ---------------------------------------------------------------------------

# "direct" | "cloudinary". En local y en tests siempre "direct":
# el seed apunta a archivos del propio proyecto y no sale a la red.
VIDEO_PROVIDER=direct

# Nombre de la cuenta de Cloudinary. Console > Dashboard > Product Environment.
# Solo se usa en el servidor: el proveedor arma las URLs y las manda como props.
CLOUDINARY_CLOUD_NAME=

# Clave publica de la API de Cloudinary. Console > Settings > API Keys.
CLOUDINARY_API_KEY=

# SECRETO. Firma las subidas del navegador. Nunca sale del servidor.
# Console > Settings > API Keys > "API Secret" (hay que revelarlo).
CLOUDINARY_API_SECRET=

# Carpeta destino dentro de Cloudinary. Un nivel por entorno evita mezclar.
CLOUDINARY_UPLOAD_FOLDER=carta/dev

# Perfil de streaming adaptativo que Cloudinary aplica al servir el .m3u8.
# Console > Settings > Video > Streaming profiles.
CLOUDINARY_STREAMING_PROFILE=hd

# ---------------------------------------------------------------------------
# Sitio — requerida desde el paso 17 (metadata y URLs absolutas)
# ---------------------------------------------------------------------------

# Origen publico del sitio, sin barra final. En local: http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Tarea programada — requerida desde el paso 18
# ---------------------------------------------------------------------------

# Protege /api/keep-alive, la tarea diaria que evita que Supabase pause el
# proyecto gratis por inactividad. Vercel lo envia como Authorization: Bearer.
# Generalo con:  openssl rand -hex 32
CRON_SECRET=
